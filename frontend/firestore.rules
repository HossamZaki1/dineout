rules_version = '2';

// The Flutter client never reads or writes Firestore directly: all conversation
// data goes through the backend, which uses the Admin SDK and bypasses these
// rules entirely. Denying everything here means that if client-side access is
// ever added, it fails closed instead of silently inheriting an open database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
