# Gemini, used by ChatAgent for intent extraction and conversation.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Google Maps Platform, used for Geocoding and Places (New).
# Restrict this key to the Geocoding API and Places API (New).
GOOGLE_MAPS_API_KEY=your-maps-platform-api-key

# Firebase project whose ID tokens this API accepts.
FIREBASE_PROJECT_ID=dineout-984f0

# Optional separate Firestore project; defaults to FIREBASE_PROJECT_ID.
# FIRESTORE_PROJECT_ID=your-storage-project

# Comma-separated origins allowed to call this API from a browser.
# Leave empty for mobile-only, which sends no Origin header.
ALLOWED_ORIGINS=

# Server binding. Cloud Run sets PORT itself.
HOST=0.0.0.0
PORT=8080

# Explicit local development storage. Use firestore for durable history.
# Cloud Run refuses to start with memory storage.
STORAGE_BACKEND=memory
